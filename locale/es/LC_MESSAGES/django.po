#: forge_i18n.py:461
msgid "Loaded variant"
msgstr "Variante con peso"

#: forge_i18n.py:463
msgid "Your rung"
msgstr "Tu peldaño"

#: forge_i18n.py:464
msgid "Unlocked — ready"
msgstr "Desbloqueado — listo"

#: forge_i18n.py:465
msgid "Locked"
msgstr "Bloqueado"

#: forge_i18n.py:466
msgid "Requires"
msgstr "Requiere"

#: forge_i18n.py:467
msgid "Hover or tap any node to read its cue."
msgstr "Pasa el cursor o toca cualquier nodo para leer su clave."

#: forge_i18n.py:470
msgid "Horizontal Push"
msgstr "Empuje horizontal"

#: forge_i18n.py:471
msgid "Wall Push-up"
msgstr "Lagartija en pared"

#: forge_i18n.py:472
msgid "Stand an arm’s length from a wall, body in one line. Bend the elbows to bring your chest near, then press away."
msgstr "Párate a un brazo de distancia de la pared, cuerpo en línea. Dobla los codos para acercar el pecho y empuja."

#: forge_i18n.py:474
msgid "Incline Push-up"
msgstr "Lagartija inclinada"

#: forge_i18n.py:475
msgid "Hands on a raised edge — the higher the surface, the lighter the load. Lower the surface as you get stronger."
msgstr "Manos en una orilla elevada — entre más alta la superficie, más ligera la carga. Bájala conforme te hagas más fuerte."

#: forge_i18n.py:477 templates/the_cauldron/landing.html:301
msgid "Knee Push-up"
msgstr "Lagartija de rodillas"

#: forge_i18n.py:478
msgid "From the knees, keep a straight line hip-to-head. A clean half-step before the full push-up."
msgstr "Desde las rodillas, mantén una línea recta de la cadera a la cabeza. Un medio paso limpio antes de la lagartija completa."

#: forge_i18n.py:479
msgid "Banded Knee Push-up"
msgstr "Lagartija de rodillas con liga"

#: forge_i18n.py:479 forge_i18n.py:500
msgid "Resistance band"
msgstr "Liga de resistencia"

#: forge_i18n.py:480
msgid "Loop a band across the upper back for accommodating resistance — hardest at lockout."
msgstr "Pasa una liga por la espalda alta para una resistencia variable — más dura al extender por completo."

#: forge_i18n.py:481
msgid "Full Push-up"
msgstr "Lagartija completa"

#: forge_i18n.py:482
msgid "Plank-tight, elbows tracking ~45°, chest to the floor and back. The benchmark of horizontal pressing."
msgstr "Firme como plancha, codos a ~45°, pecho al piso y de vuelta. La referencia del empuje horizontal."

#: forge_i18n.py:484
msgid "Weighted Push-up"
msgstr "Lagartija con peso"

#: forge_i18n.py:484
msgid "Plate / pack"
msgstr "Disco / mochila"

#: forge_i18n.py:485
msgid "Rest a plate or loaded pack on the upper back once bodyweight reps feel easy."
msgstr "Apoya un disco o una mochila cargada en la espalda alta cuando las reps con tu peso se sientan fáciles."

#: forge_i18n.py:486 templates/the_cauldron/landing.html:303
msgid "Diamond Push-up"
msgstr "Lagartija diamante"

#: forge_i18n.py:487
msgid "Hands together under the chest forming a diamond. Shifts the load onto the triceps and inner chest."
msgstr "Manos juntas bajo el pecho formando un diamante. Pasa la carga a los tríceps y al pecho interno."

#: forge_i18n.py:489
msgid "Archer Push-up"
msgstr "Lagartija arquero"

#: forge_i18n.py:490
msgid "Shift your weight over one arm while the other stays straight. The doorway to the one-arm push-up."
msgstr "Pasa tu peso sobre un brazo mientras el otro se queda estirado. La puerta a la lagartija a un brazo."

#: forge_i18n.py:493
msgid "Vertical Pull"
msgstr "Jalón vertical"

#: forge_i18n.py:494
msgid "Australian Row"
msgstr "Remo australiano"

#: forge_i18n.py:495
msgid "Hang under a waist-high bar, body straight, and row your chest to it. Walk the feet forward to ease it."
msgstr "Cuélgate bajo una barra a la altura de la cintura, cuerpo recto, y lleva el pecho hacia ella. Adelanta los pies para hacerlo más fácil."

#: forge_i18n.py:497
msgid "Negative Pull-up"
msgstr "Dominada negativa"

#: forge_i18n.py:498
msgid "Jump or step to the top, then lower yourself as slowly as you can. Builds the strength to pull up."
msgstr "Salta o súbete hasta arriba y baja lo más lento que puedas. Construye la fuerza para subir."

#: forge_i18n.py:500
msgid "Banded Pull-up"
msgstr "Dominada con liga"

#: forge_i18n.py:501
msgid "Stand in a band looped over the bar — it gives the most help at the bottom where you’re weakest."
msgstr "Párate en una liga amarrada a la barra — ayuda más abajo, donde eres más débil."

#: forge_i18n.py:503
msgid "Pull-up"
msgstr "Dominada"

#: forge_i18n.py:504
msgid "Dead hang to chin-over-bar, no kip. The gold standard of vertical pulling strength."
msgstr "Desde colgado por completo hasta la barbilla sobre la barra, sin impulso. El estándar de oro del jalón vertical."

#: forge_i18n.py:505
msgid "Weighted Pull-up"
msgstr "Dominada con peso"

#: forge_i18n.py:505
msgid "Belt / pack"
msgstr "Cinturón / mochila"

#: forge_i18n.py:506
msgid "Add load on a dip belt once you clear clean reps. The fastest route to raw pulling power."
msgstr "Agrega peso con un cinturón de lastre cuando salgan reps limpias. La ruta más rápida a la fuerza de jalón pura."

#: forge_i18n.py:508
msgid "Archer Pull-up"
msgstr "Dominada arquero"

#: forge_i18n.py:509
msgid "Pull to one hand while the other arm stays straight along the bar. The bridge to a one-arm pull-up."
msgstr "Jala hacia una mano mientras el otro brazo se queda estirado sobre la barra. El puente a la dominada a un brazo."

#: forge_i18n.py:512
msgid "Vertical Push"
msgstr "Empuje vertical"

#: forge_i18n.py:513
msgid "Incline Pike Push-up"
msgstr "Lagartija pike inclinada"

#: forge_i18n.py:514
msgid "Feet raised, hips high in a pike. Press the crown of your head toward the floor and back up."
msgstr "Pies elevados, cadera alta en pike. Lleva la coronilla hacia el piso y vuelve a subir."

#: forge_i18n.py:515
msgid "Pike Push-up"
msgstr "Lagartija pike"

#: forge_i18n.py:516
msgid "Floor pike, hips stacked over the shoulders. Deepen the range until the head taps the ground."
msgstr "Pike en el piso, cadera sobre los hombros. Profundiza el rango hasta que la cabeza toque el piso."

#: forge_i18n.py:517
msgid "Wall Handstand Push-up"
msgstr "Flexión en parada de manos en pared"

#: forge_i18n.py:518
msgid "Kick to the wall and press. Chest-to-wall is the honest version; lower under control."
msgstr "Sube a la pared con impulso de pierna y empuja. Pecho a la pared es la versión honesta; baja con control."

#: forge_i18n.py:519
msgid "Handstand Push-up"
msgstr "Flexión en parada de manos"

#: forge_i18n.py:520
msgid "Free-balanced, full range. Overhead pressing strength meets total-body control."
msgstr "En equilibrio libre, rango completo. La fuerza de empuje sobre la cabeza se une al control de todo el cuerpo."

#: forge_i18n.py:522
msgid "Lower Unilateral"
msgstr "Pierna unilateral"

#: forge_i18n.py:523
msgid "Assisted Split Squat"
msgstr "Sentadilla dividida asistida"

#: forge_i18n.py:524
msgid "Split stance, one hand on a rail for balance. Drop the back knee toward the floor and drive up."
msgstr "Postura dividida, una mano en un barandal para equilibrarte. Baja la rodilla de atrás hacia el piso y empuja hacia arriba."

#: forge_i18n.py:525
msgid "Split Squat"
msgstr "Sentadilla dividida"

#: forge_i18n.py:526
msgid "Unsupported split stance. Vertical torso, front heel planted, full depth each rep."
msgstr "Postura dividida sin apoyo. Torso vertical, talón de adelante plantado, profundidad completa en cada rep."

#: forge_i18n.py:527
msgid "Goblet Split Squat"
msgstr "Sentadilla dividida goblet"

#: forge_i18n.py:527
msgid "Dumbbell / KB"
msgstr "Mancuerna / pesa rusa"

#: forge_i18n.py:528
msgid "Hold a weight at the chest. The cleanest way to overload the legs without a barbell."
msgstr "Sostén un peso al pecho. La forma más limpia de sobrecargar las piernas sin barra."

#: forge_i18n.py:529
msgid "Bulgarian Split Squat"
msgstr "Sentadilla búlgara"

#: forge_i18n.py:530
msgid "Rear foot on a bench. Brutal single-leg range and balance — the legs’ true test."
msgstr "Pie de atrás en un banco. Rango y equilibrio brutales a una pierna — la verdadera prueba de las piernas."

#: forge_i18n.py:531
msgid "Loaded Bulgarian"
msgstr "Búlgara con peso"

#: forge_i18n.py:531 templates/the_cauldron/forge.html:86
msgid "Dumbbells"
msgstr "Mancuernas"

#: forge_i18n.py:532
msgid "A dumbbell in each hand. Among the highest-yield lower-body movements there is."
msgstr "Una mancuerna en cada mano. De los movimientos de pierna que más rinden."

#: forge_i18n.py:533
msgid "Pistol Squat"
msgstr "Sentadilla pistola"

#: forge_i18n.py:534
