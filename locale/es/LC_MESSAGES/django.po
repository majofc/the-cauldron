#: templates/the_cauldron/grimoire.html:193
msgid "Optional. They let recipes use cups, spoons or pieces of this ingredient."
msgstr "Opcional. Permiten usar tazas, cucharadas o piezas de este ingrediente en las recetas."

#: templates/the_cauldron/grimoire.html:195
msgid "One cup weighs"
msgstr "Una taza pesa"

#: templates/the_cauldron/grimoire.html:196
msgid "One tablespoon weighs"
msgstr "Una cucharada pesa"

#: templates/the_cauldron/grimoire.html:197
msgid "One piece weighs"
msgstr "Una pieza pesa"

#: templates/the_cauldron/grimoire.html:204
msgid "Leave a field blank if you don't know it — it shows as “—”, never as 0."
msgstr "Deja en blanco lo que no sepas — se muestra como “—”, nunca como 0."

#: templates/the_cauldron/grimoire.html:208
msgid "Suggest it for the shared catalog (staff review)"
msgstr "Sugerirlo para el catálogo compartido (revisión del equipo)"

#: templates/the_cauldron/grimoire.html:209
#, python-format
msgid "Ingredients are reference data, not private content: our team may review them and add them to the shared catalog at any time, without notice. Don't include personal data. <a href=\"%(terms_url)s\" target=\"_blank\" rel=\"noopener\">See the Terms</a>."
msgstr "Los ingredientes son datos de referencia, no contenido privado: nuestro equipo puede revisarlos y agregarlos al catálogo compartido en cualquier momento, sin aviso. No incluyas datos personales. <a href=\"%(terms_url)s\" target=\"_blank\" rel=\"noopener\">Consulta los Términos</a>."

#: templates/the_cauldron/grimoire.html:213
msgid "Save ingredient"
msgstr "Guardar ingrediente"

#: templates/the_cauldron/grimoire.html:222
msgid "Keep your spells, share the good ones with the coven, and make theirs your own."
msgstr "Guarda tus hechizos, comparte los buenos con el aquelarre y haz tuyos los de ellos."

